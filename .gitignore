# Virtualenvs
.venv/
.venv*/

# Dataset: public on Kaggle (CC0), 2.3 GB of images + the resize/crop/align caches
# https://www.kaggle.com/datasets/niten19/face-shape-dataset
# splits/ is NOT ignored — the exact partitions used by every run are committed.
data/

# Figures and tables generated by the analysis scripts, in case they are ever
# produced inside the repo instead of the sibling ../paper_assets/.
paper_assets/

# Model checkpoints — ~110 MB each, 3.9 GB across the 56 runs.
# Per-run results.json / epochs.csv / test_predictions.npz / confusion_matrix.png
# ARE tracked, so every number in the paper stays reproducible from this repo.
best.pt
*.pt
*.pth

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local scratch
_smoke/
